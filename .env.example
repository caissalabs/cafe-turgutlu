# Kopyalayıp `.env.local` olarak kaydedin (bu dosya git'e girmez örnek olarak kalır).
# ÖNEMLİ: Vite bu değişkenleri istemci paketine gömer. Üretimde gerçek güvenlik için
# Supabase RLS politikaları ve HTTPS kullanın.

# Supabase (Dashboard → Project Settings → API) — zorunlu
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# OAuth (Google): Üretimde redirect URL için kök adres; boşsa window.location.origin kullanılır.
# Supabase Dashboard → Authentication → URL Configuration:
#   Redirect URLs içine şunları ekleyin (localhost + üretim):
#   https://<domain>/auth/callback
#   https://<domain>/auth/sifre-yenile
#   http://localhost:5173/auth/callback
#   http://localhost:5173/auth/sifre-yenile
# VITE_SITE_URL=https://your-domain.com
#
# Menü QR kodlarında kullanılan tam kök URL (OAuth ile aynı); boşsa tarayıcı origin’i kullanılır.
# Üretimde QR’ların doğru siteye işaret etmesi için mutlaka ayarlayın.
