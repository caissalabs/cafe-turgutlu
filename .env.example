# Kopyalayıp `.env.local` olarak kaydedin (bu dosya git'e girmez örnek olarak kalır).
# ÖNEMLİ: Vite bu değişkenleri istemci paketine gömer. Üretimde gerçek güvenlik için
# sunucu tarafı doğrulama + HTTPS kullanın.

VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=guclu-bir-sifre-degistirin

# Supabase (Dashboard → Project Settings → API): siparişleri cihazlar arası senkronlar
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# QR kod sayfasında kullanılacak kök URL (Railway örn. https://xxx.up.railway.app):
# VITE_PUBLIC_SITE_URL=https://your-production-domain.example
